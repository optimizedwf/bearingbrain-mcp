# BearingBrain MCP public environment template
# Copy to .env for local experiments. Do not commit real values.

# Public app URL used when generating links.
APP_URL=https://bearingbrain.com
NEXT_PUBLIC_BASE_URL=https://bearingbrain.com

# Optional catalog database. Required for search_catalog and full catalog-backed routing.
DATABASE_URL=postgres://localhost:5432/bearingbrain

# Optional AI providers for private-app helper paths.
SITE_AGENT_PROVIDER=pi
PI_AGENT_BIN=pi
PI_AGENT_MODEL=google/gemini-3.1-pro-preview
PI_PARSE_MODEL=google/gemini-3.1-pro-preview
PI_AGENT_THINKING=minimal
PI_AGENT_TIMEOUT_MS=12000
PI_AGENT_CWD=/tmp
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# Optional parts chat tuning.
PARTS_CHAT_MODEL=google/gemini-3.1-pro-preview
PARTS_HELPER_MODEL=google/gemini-3.1-pro-preview
PARTS_PLANNER_MODEL=google/gemini-3.1-pro-preview
PARTS_REWRITE_MODEL=google/gemini-3.1-pro-preview
PARTS_PARAMS_MODEL=google/gemini-3.1-pro-preview
PARTS_CHAT_TIMEOUT_MS=22000
PARTS_CHAT_THINKING=high
PARTS_EXTRACT_THINKING=minimal
PARTS_REWRITE_THINKING=minimal
PARTS_AGENT_PLANNER_THINKING=high
FAILURE_DIAG_MODEL=gemini-2.5-flash

# Optional external supplier/API integrations.
SKF_API_BASE=https://skf-api-external-eu20-tyvvw4iy.prod.apimanagement.eu20.hana.ondemand.com:443/v1/pim
SKF_API_KEY=
CJ_PUBLISHER_ID=
CJ_DEEP_LINK_BASE=https://www.anrdoezrs.net
ZORO_CJ_ADVERTISER_ID=10046064
AMAZON_ASSOCIATE_TAG=example-20

# Optional private app features copied from the main product repo.
JWT_SECRET=change-me-for-local-dev-only
STRIPE_SECRET_KEY=
